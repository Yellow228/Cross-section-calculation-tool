# ===== Python 环境 / 缓存 =====
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ===== 构建与打包产物 =====
dist/
build/
build_prev_*/

# ===== 打包时生成（每次构建都变，不该进仓库） =====
src/core/_build_info.py

# ===== 运行输出 / 临时文件 =====
output/
# 根目录的临时文件（memo / 日志 / 命令输出重定向 / 一次性脚本）。
# 按**前缀**一刀切，而不是逐个列扩展名：原来只写了 `_*.txt`，
# 一次 `git add -A` 就把 `_c1.log` 卷进了发版提交。
# 用 `/` 锚定，只作用于仓库根目录，不会误伤 src 里的模块。
/_*

# ===== 不入库的本地产物与输入 =====
# 这三样都**只在本机存在**，仓库里不保留（详见 README「目录结构」）。

# 离线依赖，21 个 wheel 约 108 MB，占仓库体积 99%；
# 且会把 .git 撑到 100 MB 量级（GitHub 单文件 50 MB 就告警）。
# 需要时用 tools/fetch_wheels.py 按 wheels_urls.txt 下载。
wheels/

# 真实测量数据（断面 xlsx），含具体地名，不适合随仓库分发。
# 使用者自备，放进这个目录即可。
data/

# 本地工作记录：含本机绝对路径、Windows 用户名，以及面向内部的过程笔记
# （决策复盘、"我哪里做错了"之类），不是给外部看的材料。
# ⚠ 这个目录是工具的本地资料库，**不要删除**，只是不提交。
.workbuddy/

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
